{
  "name": "Linux Diagnostic Collector & USB Builder",
  "endpoint": "linuxcollector-installer",
  "usb_builder_endpoint": "linux-usb-installer",
  "version": "1.0.0",
  "description": "Linux-based offline Windows diagnostic collector. Boots Debian Live USB to unlock BitLocker drives, collect event logs, registry hives, crash dumps, and upload to server. Companion to WinPE Collector for Linux-based recovery.",
  "created": "2025-12-17",
  "environment": "Debian Live",
  "requirements": [
    "Debian/Ubuntu host (or WSL2 with USB passthrough) for USB creation",
    "Root privileges",
    "Internet connection (for ISO and package download)",
    "USB drive (8GB+ recommended)"
  ],
  "features": [
    "BitLocker unlock with dislocker (recovery key)",
    "Offline Windows partition detection",
    "Event log collection (.evtx files)",
    "Registry hive collection (SYSTEM, SOFTWARE, DEFAULT)",
    "Windows Update/CBS/DISM log collection",
    "Setup/Upgrade log collection (Panther/MoSetup)",
    "Crash dump collection (minidumps, MEMORY.DMP)",
    "Disk health diagnostics (SMART)",
    "ZIP archive creation and upload",
    "Multiple upload methods (HTTPS, SCP, local copy)"
  ],
  "tools_included": {
    "bitlocker": ["dislocker"],
    "partition_management": ["parted", "gdisk", "sgdisk", "fdisk"],
    "data_recovery": ["testdisk", "ddrescue"],
    "filesystems": ["ntfs-3g", "e2fsprogs", "xfsprogs", "btrfs-progs", "dosfstools"],
    "diagnostics": ["smartmontools", "hdparm", "nvme-cli"],
    "system_info": ["lshw", "dmidecode", "pciutils", "usbutils"],
    "volume_management": ["lvm2", "mdadm", "cryptsetup"],
    "utilities": ["curl", "wget", "rsync", "zip", "unzip", "tmux", "htop"]
  },
  "scripts": {
    "collector": "Linux-Collector.sh",
    "usb_builder": "Build-Linux-USB.sh",
    "collector_installer": "install-linuxcollector.sh",
    "usb_builder_installer": "install-linux-usb-builder.sh"
  },
  "collected_data": [
    "Event logs (all .evtx files)",
    "Registry hives (SYSTEM, SOFTWARE, DEFAULT - SAM/SECURITY excluded)",
    "Linux environment snapshot (network/storage)",
    "Windows Update logs",
    "CBS logs (Component-Based Servicing)",
    "DISM logs (Image servicing)",
    "Panther logs (Windows Setup)",
    "MoSetup logs (Windows Setup/Upgrade)",
    "SetupAPI device installation logs",
    "Startup Repair logs (SrtTrail when present)",
    "NetSetup logs (domain join/network history)",
    "BitLocker status",
    "Disk health (SMART data)",
    "Crash dumps (minidumps, MEMORY.DMP if < 500MB)"
  ],
  "output": {
    "format": "ZIP archive",
    "naming": "Linux-Diag-{ComputerName}-{Serial}-{Timestamp}.zip",
    "upload_url": "<<SERVERURL>>/upload"
  },
  "author": "jeamajoal",
  "license": "MIT"
}
