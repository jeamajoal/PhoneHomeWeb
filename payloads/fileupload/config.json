{
  "name": "FileUploader",
  "endpoint": "fileupload",
  "version": "1.1.0",
  "description": "Multi-method file uploader payload supporting HTTPS, FTP, SFTP, curl, and tech-assisted uploads",
  "serverUrl": "<<SERVERURL>>",
  "downloadFolder": "FileUpload",
  "mainScript": "FileUpload.ps1",
  "scripts": {
    "https-powershell": {
      "file": "FileUpload.ps1",
      "description": "PowerShell HTTPS upload using System.Net.Http",
      "platform": "Windows"
    },
    "https-curl": {
      "file": "FileUpload-Curl.sh",
      "description": "Bash/curl HTTPS upload for Linux, macOS, and WSL",
      "platform": "Linux/macOS/WSL"
    },
    "ftp": {
      "file": "FileUpload-FTP.ps1",
      "description": "FTP upload using PowerShell FtpWebRequest",
      "platform": "Windows"
    },
    "sftp": {
      "file": "FileUpload-SFTP.ps1",
      "description": "SFTP upload using OpenSSH (Windows 10+ built-in or installed)",
      "platform": "Windows/Linux"
    },
    "tech-assist": {
      "file": "FileUpload-TechAssist.ps1",
      "description": "Interactive guided upload helper for tech support scenarios",
      "platform": "Windows"
    }
  },
  "parameters": [
    {
      "name": "ServerUrl",
      "type": "string",
      "description": "Base server URL, e.g. https://example.com:3500"
    },
    {
      "name": "FilePath",
      "type": "string",
      "description": "Path to the file to be uploaded"
    },
    {
      "name": "AuthKey",
      "type": "string",
      "description": "Authentication key for secure upload"
    }
  ],
  "requirements": [
    "Windows 10/11 or Linux/macOS",
    "PowerShell 5.1+ (for PowerShell scripts)",
    "curl (for Bash script)",
    "Network connectivity"
  ],
  "author": "jeamajoal",
  "license": "MIT"
}
